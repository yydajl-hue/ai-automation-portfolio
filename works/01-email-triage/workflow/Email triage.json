    {
      "parameters": {
        "jsCode": "const ALLOWED = ['sales_inquiry', 'support', 'complaint', 'partnership', 'spam'];\nconst form = $('On form submission').first().json;\nreturn $input.all().map(item => {\n  let r = {};\n  let note = '';\n  try {\n    r = JSON.parse(item.json.choices[0].message.content);\n  } catch (e) {\n    note = 'Model reply could not be read - check manually';\n  }\n  return { json: {\n    received_at: new Date().toISOString(),\n    name: form.Name,\n    email: form.Email,\n    message: form.Message,\n    category: ALLOWED.includes(r.category) ? r.category : 'needs_review',\n    priority: ['high', 'medium', 'low'].includes(r.priority) ? r.priority : 'medium',\n    summary: r.summary || note,\n    reply_needed: r.reply_needed === true || r.reply_needed === 'true'\n  }};\n});"
